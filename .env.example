# ==============================================================================
# Dhatree AI Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` in your local root directory and adjust as necessary.
# NEVER commit your actual `.env` file containing sensitive secrets to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Neon Free-Tier)
# ------------------------------------------------------------------------------
# Format: postgres://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgres://dhatree_user:dhatree_secret_password@postgres:5432/dhatree_ai_db

# ------------------------------------------------------------------------------
# Redis & Celery Configuration (Upstash Free-Tier)
# ------------------------------------------------------------------------------
# Format: rediss://default:[password]@[upstash_hostname]:[port]
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# Media Storage Configuration (Cloudinary Free-Tier)
# ------------------------------------------------------------------------------
# Format: cloudinary://[api_key]:[api_secret]@[cloud_name]
CLOUDINARY_URL=

# ------------------------------------------------------------------------------
# JWT Authentication Settings
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=jwt-insecure-replace-this-secret-key-for-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# CORS & Security Settings
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# AI Engine Configuration
# ------------------------------------------------------------------------------
AI_MODEL_REGISTRY_PATH=backend/ai_engine/models
AI_INFERENCE_BATCH_SIZE=32
AI_USE_GPU=False

# ------------------------------------------------------------------------------
# Frontend Vite Configuration (must be prefixed with VITE_)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="Dhatree AI - Digital Agriculture Platform"
VITE_DEFAULT_LOCALE=en-US
